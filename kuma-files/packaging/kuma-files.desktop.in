[Desktop Entry]
Type=Application
Name=Koguma
GenericName=File Manager
Comment=Browse files and folders
Keywords=files;folders;file manager;kuma;koguma;
Exec=@BIN@/kuma-files %u
Icon=kuma-files
Terminal=false
Categories=System;FileManager;
MimeType=inode/directory;x-scheme-handler/file;image/png;image/jpeg;image/webp;image/gif;image/tiff;application/pdf;
StartupNotify=true
