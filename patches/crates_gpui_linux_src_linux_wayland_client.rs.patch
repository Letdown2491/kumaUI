+const DRAG_ICON_WIDTH: i32 = 128;
+const DRAG_ICON_HEIGHT: i32 = 32;
+
+/// A CPU-rendered drag icon: one SHM pool, one buffer, one surface. The
+/// pixels are a rounded accent pill; the ghost view inside the window
+/// already shows the file name, this just makes the drag visible outside.
+struct DragIcon {
+    _file: std::fs::File,
+    surface: wl_surface::WlSurface,
+    pool: wl_shm_pool::WlShmPool,
+    buffer: wl_buffer::WlBuffer,
+}
+
+impl Drop for DragIcon {
+    fn drop(&mut self) {
+        self.buffer.destroy();
+        self.pool.destroy();
+        self.surface.destroy();
+    }
+}
+
+fn create_drag_icon(globals: &Globals, label: Option<String>) -> Option<DragIcon> {
+    use std::io::{Seek, SeekFrom, Write};
+    use std::os::fd::{AsFd, FromRawFd};
+
+    let width = DRAG_ICON_WIDTH;
+    let height = DRAG_ICON_HEIGHT;
+    let stride = width * 4;
+    let size = (stride * height) as usize;
+
+    let fd = unsafe {
+        libc::memfd_create(b"kuma-drag-icon\0".as_ptr() as *const libc::c_char, libc::MFD_CLOEXEC)
+    };
+    if fd < 0 {
+        log::error!("drag icon: memfd_create failed");
+        return None;
+    }
+    let mut file = unsafe { std::fs::File::from_raw_fd(fd) };
+    file.set_len(size as u64).ok()?;
+
+    // Argb8888 is little-endian in memory: b, g, r, a.
+    let mut pixels = vec![0u8; size];
+    let radius = 8.0f32;
+    let half_w = width as f32 / 2.0;
+    let half_h = height as f32 / 2.0;
+    for y in 0..height {
+        for x in 0..width {
+            let dx = ((x as f32 + 0.5) - half_w).abs() - (half_w - radius);
+            let dy = ((y as f32 + 0.5) - half_h).abs() - (half_h - radius);
+            let outside_corner = dx > 0.0 && dy > 0.0 && dx * dx + dy * dy > radius * radius;
+            if outside_corner {
+                continue;
+            }
+            let i = (y * stride + x * 4) as usize;
+            pixels[i] = 0xc9; // blue
+            pixels[i + 1] = 0x8c; // green
+            pixels[i + 2] = 0x4f; // red
+            pixels[i + 3] = 0xd9; // alpha
+        }
+    }
+    if let Some(label) = label {
+        draw_drag_label(&mut pixels, width, height, stride, &label);
+    }
+    file.write_all(&pixels).ok()?;
+    file.seek(SeekFrom::Start(0)).ok()?;
+
+    let pool = globals
+        .shm
+        .create_pool(file.as_fd(), size as i32, &globals.qh, ());
+    let buffer = pool.create_buffer(
+        0,
+        width,
+        height,
+        stride,
+        wl_shm::Format::Argb8888,
+        &globals.qh,
+        (),
+    );
+
+    let surface = globals.compositor.create_surface(&globals.qh, ());
+    surface.attach(Some(&buffer), 0, 0);
+    surface.damage(0, 0, width, height);
+    surface.commit();
+
+    Some(DragIcon {
+        _file: file,
+        surface,
+        pool,
+        buffer,
+    })
+}
+
+/// Composites a white label into the pill: one A8 canvas per glyph,
+/// rasterized by font-kit's freetype loader, blitted by alpha. The glyph
+/// origin is the baseline's left end; the canvas position comes from
+/// `raster_bounds` of the very same transform, so no font metrics math
+/// beyond the baseline offset is needed.
+fn draw_drag_label(pixels: &mut [u8], width: i32, height: i32, stride: i32, label: &str) {
+    use font_kit::canvas::{Canvas, Format as CanvasFormat, RasterizationOptions};
+    use font_kit::hinting::HintingOptions;
+    use font_kit::family_name::FamilyName;
+    use font_kit::properties::Properties;
+    use font_kit::source::SystemSource;
+    use pathfinder_geometry::transform2d::Transform2F;
+    use pathfinder_geometry::vector::Vector2F;
+
+    let size = 13.0f32;
+    let pad = 12.0f32;
+    let font = match SystemSource::new()
+        .select_best_match(&[FamilyName::SansSerif], &Properties::new())
+    {
+        Ok(handle) => match handle.load() {
+            Ok(font) => font,
+            Err(err) => {
+                log::info!("drag icon: font failed to load: {err}");
+                return;
+            }
+        },
+        Err(err) => {
+            log::info!("drag icon: no font for the label: {err}");
+            return;
+        }
+    };
+    let metrics = font.metrics();
+    let scale = size / metrics.units_per_em as f32;
+    // center the (ascent, descent) band vertically; descent is negative
+    let baseline_y = height as f32 / 2.0 + (metrics.ascent + metrics.descent) * scale / 2.0;
+
+    // Measure with the transform baked in, truncating to the pill's width.
+    let max_width = width as f32 - 2.0 * pad;
+    let mut placed: Vec<(u32, pathfinder_geometry::rect::RectI, Transform2F)> = Vec::new();
+    let mut pen_x = pad;
+    for ch in label.chars() {
+        let Some(glyph) = font.glyph_for_char(ch) else {
+            continue;
+        };
+        let transform = Transform2F::from_translation(Vector2F::new(pen_x, baseline_y));
+        let Ok(rect) = font.raster_bounds(
+            glyph,
+            size,
+            transform,
+            HintingOptions::None,
+            RasterizationOptions::GrayscaleAa,
+        ) else {
+            continue;
+        };
+        pen_x += rect.width() as f32 + 1.0;
+        if pen_x > pad + max_width {
+            break;
+        }
+        placed.push((glyph, rect, transform));
+    }
+    if placed.is_empty() {
+        return;
+    }
+
+    for (glyph, rect, transform) in placed {
+        let mut canvas = Canvas::new(rect.size(), CanvasFormat::A8);
+        if font
+            .rasterize_glyph(
+                &mut canvas,
+                glyph,
+                size,
+                Transform2F::from_translation(-rect.origin().to_f32()) * transform,
+                HintingOptions::None,
+                RasterizationOptions::GrayscaleAa,
+            )
+            .is_err()
+        {
+            continue;
+        }
+        let ox = rect.origin_x();
+        let oy = rect.origin_y();
+        for row in 0..canvas.size.y() {
+            let py = oy + row;
+            if py < 0 || py >= height {
+                continue;
+            }
+            for col in 0..canvas.size.x() {
+                let px = ox + col;
+                if px < 0 || px >= width {
+                    continue;
+                }
+                let a = canvas.pixels[row as usize * canvas.stride + col as usize];
+                if a == 0 {
+                    continue;
+                }
+                let i = (py * stride + px * 4) as usize;
+                let t = a as f32 / 255.0;
+                let p = pixels[i + 3] as f32 / 255.0;
+                let mix = |c: u8| (c as f32 * (1.0 - t) + 255.0 * t) as u8;
+                pixels[i] = mix(pixels[i]);
+                pixels[i + 1] = mix(pixels[i + 1]);
+                pixels[i + 2] = mix(pixels[i + 2]);
+                pixels[i + 3] = ((t + p * (1.0 - t)) * 255.0) as u8;
+            }
+        }
+    }
+}
